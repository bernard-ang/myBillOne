{
  "name": "grabbill-ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm:start:client\" \"npm:start:admin\"",
    "start:client": "ng serve client",
    "start:admin": "ng serve admin",
    "start:website": "ng serve website",
    "start:op-client": "ng serve -c op client",
    "build": "concurrently \"npm:build:client\" \"npm:build:admin\" \"npm:build:website\"",
    "build:client": "ng build client",
    "build:admin": "ng build admin",
    "build:website": "ng build website",
    "build:op-client": "ng build -c op client",
    "build-prod:op-sunlife": "ng build -c opprodsunlife client",
    "build-prod:op-generali": "ng build -c opprodgenerali client",
    "build-uat:op-client": "ng build -c opuat client",
    "build-uat": "concurrently \"npm:build-uat:client\" \"npm:build-uat:admin\" \"npm:build-uat:website\"",
    "build-uat:client": "ng build --configuration uat client",
    "build-uat:admin": "ng build --configuration uat admin",
    "build-uat:website": "ng build --configuration uat website",
    "build:client-stats": "ng build client --stats-json",
    "build:admin-stats": "ng build admin --stats-json",
    "build:website-stats": "ng build admin --stats-json",
    "analyze:client": "webpack-bundle-analyzer dist/client/stats.json",
    "analyze:admin": "webpack-bundle-analyzer dist/admin/stats.json",
    "analyze:website": "webpack-bundle-analyzer dist/website/stats.json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.3.10",
    "@angular/common": "^17.3.10",
    "@angular/compiler": "^17.3.10",
    "@angular/core": "^17.3.10",
    "@angular/forms": "^17.3.10",
    "@angular/platform-browser": "^17.3.10",
    "@angular/platform-browser-dynamic": "^17.3.10",
    "@angular/router": "^17.3.10",
    "@fontsource/poppins": "^4.5.8",
    "@ngneat/tailwind": "^7.0.3",
    "@ngxs/router-plugin": "^3.8.2",
    "@ngxs/store": "^3.8.2",
    "@swimlane/ngx-charts": "^20.1.0",
    "countries-map": "^4.10.0",
    "country-state-city": "^3.1.0",
    "date-fns": "^2.28.0",
    "file-saver": "^2.0.5",
    "firebase": "^9.9.2",
    "grapesjs": "^0.21.10",
    "grapesjs-mjml": "^1.0.5",
    "immer": "^9.0.12",
    "lodash": "^4.17.21",
    "marked": "^12.0.2",
    "mjml-browser": "^4.12.0",
    "ng-zorro-antd": "^17.4.1",
    "ngx-markdown": "^17.2.1",
    "papaparse": "^5.3.2",
    "pretty-bytes": "^6.0.0",
    "rxjs": "~7.5.0",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.0/xlsx-0.20.0.tgz",
    "xlsx-populate": "^1.21.0",
    "zone.js": "~0.14.6"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.3.8",
    "@angular/cli": "^17.3.8",
    "@angular/compiler-cli": "^17.3.10",
    "@angular/localize": "^17.3.10",
    "@types/d3-scale": "^4.0.2",
    "@types/d3-selection": "^3.0.2",
    "@types/file-saver": "^2.0.5",
    "@types/jasmine": "~3.10.0",
    "@types/lodash": "^4.14.182",
    "@types/marked": "^4.3.2",
    "@types/node": "^12.11.1",
    "@types/papaparse": "^5.3.2",
    "autoprefixer": "^10.4.2",
    "concurrently": "^9.2.1",
    "jasmine-core": "~4.0.0",
    "karma": "~6.3.0",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.1.0",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.7.0",
    "ng-packagr": "^17.3.0",
    "postcss": "^8.4.8",
    "prettier": "2.5.1",
    "tailwindcss": "^3.0.23",
    "typescript": "~5.4.5",
    "webpack-bundle-analyzer": "^4.7.0"
  }
}
